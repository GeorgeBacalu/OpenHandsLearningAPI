{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ManageApplicationMedia",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:DeleteObject"],
      "Resource": [
        "arn:aws:s3:::open-hands-learning/dev/voice/*",
        "arn:aws:s3:::open-hands-learning/dev/categories/*",
        "arn:aws:s3:::open-hands-learning/prod/voice/*",
        "arn:aws:s3:::open-hands-learning/prod/categories/*"
      ]
    },
    {
      "Sid": "AuditApplicationMedia",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::open-hands-learning"
    }
  ]
}
