  "components": {
    "schemas": {
      "CategoryDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "parentId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "mediaKey": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$",
            "maxLength": 255
          },
          "isFavorite": {
            "type": "boolean",
            "readOnly": true
          },
          "isExpanded": {
            "type": "boolean",
            "readOnly": true,
            "deprecated": true
          }
        },
        "required": [
          "name"
        ]
      },
      "SchoolDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "cityId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "name",
          "cityId"
        ]
      },
      "RoleDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "authority": {
            "type": "string",
            "enum": [
              "USER",
              "ADMIN"
            ]
          }
        },
        "required": [
          "authority"
        ]
      },
      "SectionDto": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "VIDEO",
              "VOICE_TO_SIGN"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "mediaKey": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$",
            "maxLength": 255
          },
          "iconKey": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$",
            "maxLength": 255
          }
        },
        "required": [
          "type",
          "name",
          "mediaKey",
          "iconKey"
        ]
      },
      "UserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "email": {
            "type": "string",
            "format": "email",
            "minLength": 1
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 72,
            "writeOnly": true,
            "description": "8 to 72 characters, with a maximum of 72 UTF-8 bytes."
          },
          "schoolId": {
            "type": "string",
            "format": "uuid"
          },
          "roleId": {
            "type": "string",
            "format": "uuid"
          },
          "phone": {
            "type": "string",
            "minLength": 10,
            "maxLength": 10
          }
        },
        "required": [
          "name",
          "email",
          "password",
          "phone",
          "schoolId",
          "roleId"
        ]
      },
      "UserResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "email": {
            "type": [
              "string",
              "null"
            ],
            "format": "email",
            "minLength": 1
          },
          "schoolId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "roleId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "phone": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 10,
            "maxLength": 10
          }
        }
      },
      "Problem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "format": "uri-reference"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string",
            "format": "uri-reference"
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      },
      "County": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "City": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "countyId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "id",
          "name",
          "countyId"
        ]
      },
      "Credentials": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "format": "password",
            "writeOnly": true
          }
        }
      },
      "Registration": {
        "type": "object",
        "required": [
          "name",
          "email",
          "password",
          "phone",
          "schoolId"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "password": {
            "type": "string",
            "format": "password",
            "minLength": 15,
            "maxLength": 72,
            "writeOnly": true,
            "description": "At most 72 UTF-8 bytes."
          },
          "phone": {
            "type": "string",
            "pattern": "^0[0-9]{9}$"
          },
          "schoolId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "Account": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "email": {
            "type": [
              "string",
              "null"
            ],
            "format": "email",
            "minLength": 1
          },
          "schoolId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "roleId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "phone": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 10,
            "maxLength": 10
          },
          "authority": {
            "type": "string",
            "enum": [
              "USER",
              "ADMIN"
            ]
          }
        }
      },
      "CsrfResponse": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "SessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "JSESSIONID"
      },
      "CsrfToken": {
        "type": "apiKey",
        "in": "header",
        "name": "X-CSRF-TOKEN"
      }
    }
  }
}
